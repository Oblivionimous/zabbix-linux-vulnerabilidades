# Forca fim de linha LF nos arquivos que o Linux e o Zabbix interpretam.
# Evita o problema de CRLF misturado que ocorre ao editar no Windows.
* text=auto eol=lf
*.py   text eol=lf
*.sh   text eol=lf
*.yaml text eol=lf
*.yml  text eol=lf
*.json text eol=lf
*.md   text eol=lf
*.service text eol=lf
*.timer   text eol=lf
